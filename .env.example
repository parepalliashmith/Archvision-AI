GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Optional — enables persistent Postgres storage for saved designs (see store.js).
# Omit this for local dev: designs are saved to data/designs.json instead.
DATABASE_URL=

# Optional — powers "Get a Builder Quote". Set ONE of these (Resend checked
# first if both are set); without either, quote requests still save, they
# just don't send an email. Resend's free tier only delivers to your own
# signup address until you verify a sending domain — Brevo doesn't have that
# restriction on its free tier.
RESEND_API_KEY=
BREVO_API_KEY=
# Where the builder's copy of each inquiry goes. Defaults to the project
# owner's address if left blank.
BUILDER_EMAIL=
# "Name <email>" the emails appear to come from. For Resend's sandbox sender
# this must stay onboarding@resend.dev unless you've verified your own domain.
EMAIL_FROM=

# Optional — signs session tokens for the email-OTP login system (see
# authTokens.js). If unset, a random secret is generated at boot (with a
# console warning) and all sessions are invalidated on restart. Set a fixed
# value in production so logins survive redeploys.
SESSION_SECRET=
